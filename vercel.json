{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run migrate && npm run awards:migrate && npm run build",
  "crons": [
    {
      "path": "/api/awards/cron/request-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/awards/cron/draft-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/awards/cron/file-cleanup",
      "schedule": "30 * * * *"
    }
  ]
}
