# Database (Neon Postgres) — pooled + unpooled
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Awards submission database. A SEPARATE database from Payload's, with its own role;
# Payload never reads or writes it. Pooled URL for the app, unpooled for
# `npm run awards:migrate` and `awards:seed` (the Vercel build runs both after Payload's migrate, so
# both must be set on Vercel before a deploy). Locally, create it once:
#   docker exec svef-pg psql -U svef -d postgres -c 'create database svef_awards'
# and point both at it, e.g. postgresql://svef:svef@localhost:5433/svef_awards
AWARDS_DATABASE_URL=
AWARDS_DATABASE_URL_UNPOOLED=

# Payload
PAYLOAD_SECRET=            # openssl rand -hex 32

# Cloudflare R2 (S3-compatible) media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=svef-assets
R2_PUBLIC_URL=https://assets.svef.is

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bylaws
# The source URL is NOT configurable — it is pinned to the HEAD ref of svef/Laws in
# src/lib/bylaws.ts. Do not reintroduce an override; a stale value in a hosting
# dashboard is how this page silently broke.
#
# Escape hatch, off by default. A failed bylaws fetch fails the build on purpose. Set
# this to 1 ONLY during a GitHub/raw.githubusercontent.com incident to unblock an
# unrelated deploy: the build then warns instead of failing and the page shows a
# visible notice linking to svef/Laws. Unset it as soon as the incident is over.
# BYLAWS_ALLOW_DEGRADED=1

# Bylaws source (public GitHub raw README of svef/Laws)
GITHUB_LAWS_RAW_URL=https://raw.githubusercontent.com/svef/Laws/main/README.md

# Umami analytics (self-hosted at stats.valdez.is). Must be a PLAIN Vercel
# variable, not Sensitive: NEXT_PUBLIC_* is inlined at build time and Sensitive
# variables are not readable during the build.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Slack incoming webhooks, one per channel, for the two public forms.
# Plain Vercel variables, not Sensitive — and never NEXT_PUBLIC_*: a webhook URL
# is a bearer credential, anyone holding it can post to that channel.
# Unset is not an error: submissions are still stored and the sender still
# thanked; only the notification is skipped, and the reason is logged.
SLACK_WEBHOOK_FEEDBACK=
SLACK_WEBHOOK_TALKS=

# Awards accounts (Better Auth). Secret: `openssl rand -hex 32`. Required in
# production; set the same value on every deployment that shares the database.
BETTER_AUTH_SECRET=
# The site's own origin, which email links (verification, password reset) are built on: set
# it on Vercel (https://svef.is in production, https://dev.svef.is on previews). Unset, the
# origin is taken from each request, which is what local runs and e2e use.
# BETTER_AUTH_URL=

# Awards email (Resend), shared by verification, reset, receipts, invitations.
# With RESEND_API_KEY unset, messages are written to .awards-outbox/ instead
# (gitignored) outside production, so account flows work locally. In production a
# missing key is an error. AWARDS_EMAIL_FROM is required when the key is set.
RESEND_API_KEY=
AWARDS_EMAIL_FROM=
# Local/e2e only, never on Vercel: lets a production build (`next start`) use the
# outbox. Ignored when VERCEL_ENV=production.
# AWARDS_EMAIL_OUTBOX=1
# Local/e2e only: turn off Better Auth's rate limiter (on by default in production).
# AWARDS_AUTH_RATE_LIMIT=off

# Guards the awards cron routes (/api/awards/cron/*): Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`, and with it unset every call is refused.
# `openssl rand -hex 32`.
CRON_SECRET=

# Awards uploads: the PRIVATE bucket for entrants' images, separate from the public
# media bucket above. S3 API: Cloudflare R2 in production, MinIO locally. The browser PUTs
# straight to it with a presigned URL, so the bucket needs a CORS rule (see README, "Awards
# uploads"). Unset, the image section reports that uploading failed and everything else works.
#   R2:    AWARDS_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   MinIO: AWARDS_R2_ENDPOINT=http://localhost:9000
AWARDS_R2_ENDPOINT=
AWARDS_R2_BUCKET=
AWARDS_R2_ACCESS_KEY_ID=
AWARDS_R2_SECRET_ACCESS_KEY=
# Comma-separated origins the bucket script (npm run awards:bucket) allows to PUT.
# AWARDS_BUCKET_ORIGINS=http://localhost:3000
