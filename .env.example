# Database (Neon Postgres) — pooled + unpooled
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Payload
PAYLOAD_SECRET=            # openssl rand -hex 32

# Cloudflare R2 (S3-compatible) media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=svef-assets
R2_PUBLIC_URL=https://assets.svef.is

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bylaws source (public GitHub raw README of svef/Laws)
GITHUB_LAWS_RAW_URL=https://raw.githubusercontent.com/svef/Laws/main/README.md

# Temporary landing one-pager: when 'true', production serves the static landing at /
# and redirects other paths to it. Set to false (or unset) to launch the full site.
LANDING_ONLY=false
