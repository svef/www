# Database (Neon Postgres) — pooled + unpooled
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Payload
PAYLOAD_SECRET=            # openssl rand -hex 32

# Cloudflare R2 (S3-compatible) media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=svef-assets
R2_PUBLIC_URL=https://assets.svef.is

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bylaws
# The source URL is NOT configurable — it is pinned to the HEAD ref of svef/Laws in
# src/lib/bylaws.ts. Do not reintroduce an override; a stale value in a hosting
# dashboard is how this page silently broke.
#
# Escape hatch, off by default. A failed bylaws fetch fails the build on purpose. Set
# this to 1 ONLY during a GitHub/raw.githubusercontent.com incident to unblock an
# unrelated deploy: the build then warns instead of failing and the page shows a
# visible notice linking to svef/Laws. Unset it as soon as the incident is over.
# BYLAWS_ALLOW_DEGRADED=1
