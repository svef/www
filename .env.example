# Database (Neon Postgres) — pooled + unpooled
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Payload
PAYLOAD_SECRET=            # openssl rand -hex 32

# Cloudflare R2 (S3-compatible) media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=svef-assets
R2_PUBLIC_URL=https://assets.svef.is

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bylaws
# The source URL is NOT configurable — it is pinned to the HEAD ref of svef/Laws in
# src/lib/bylaws.ts. Do not reintroduce an override; a stale value in a hosting
# dashboard is how this page silently broke.
#
# Escape hatch, off by default. A failed bylaws fetch fails the build on purpose. Set
# this to 1 ONLY during a GitHub/raw.githubusercontent.com incident to unblock an
# unrelated deploy: the build then warns instead of failing and the page shows a
# visible notice linking to svef/Laws. Unset it as soon as the incident is over.
# BYLAWS_ALLOW_DEGRADED=1

# Bylaws source (public GitHub raw README of svef/Laws)
GITHUB_LAWS_RAW_URL=https://raw.githubusercontent.com/svef/Laws/main/README.md

# Umami analytics (self-hosted at stats.valdez.is). Must be a PLAIN Vercel
# variable, not Sensitive: NEXT_PUBLIC_* is inlined at build time and Sensitive
# variables are not readable during the build.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Slack incoming webhooks, one per channel, for the two public forms.
# Plain Vercel variables, not Sensitive — and never NEXT_PUBLIC_*: a webhook URL
# is a bearer credential, anyone holding it can post to that channel.
# Unset is not an error: submissions are still stored and the sender still
# thanked; only the notification is skipped, and the reason is logged.
SLACK_WEBHOOK_FEEDBACK=
SLACK_WEBHOOK_TALKS=
